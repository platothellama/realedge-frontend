# RealEdge backend — environment template (KEY NAMES ONLY, no values).
# Copy to `.env` for local dev and fill in values. NEVER commit `.env`.
# Production MUST provide these via the deployment secret manager.
PORT=8000
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRE=
FRONTEND_URL=
OPENAI_API_KEY=
USE_LOCAL_EMBEDDINGS=false
EMBEDDING_MODEL=text-embedding-3-small
SENDGRID_API_KEY=
EMAIL_FROM=
API_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=realedge-uploads
# Optional: preferred over ANON key on the server (never ship to frontend).
SUPABASE_SERVICE_KEY=
GOOGLE_MAPS_API_KEY=
